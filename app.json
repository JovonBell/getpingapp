{
  "expo": {
    "name": "ping!",
    "slug": "getpingapp",
    "scheme": "getpingapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#22c55e"
    },
    "platforms": [
      "ios",
      "android"
    ],
    "plugins": [
      "expo-apple-authentication",
      "expo-contacts",
      "expo-image-picker",
      "expo-notifications",
      "expo-web-browser",
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "Ping needs NFC access to program your ring for contact sharing",
          "selectIdentifiers": [],
          "systemCodes": [],
          "includeNdefEntitlement": false
        }
      ],
      [
        "./plugins/withIosDeploymentTarget",
        {
          "deploymentTarget": "15.1"
        }
      ],
      "expo-asset"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "today.getping.app",
      "deploymentTarget": "15.1",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSContactsUsageDescription": "Ping uses your contacts to help you build your circles and find who you already know on ping.",
        "NSCameraUsageDescription": "Ping uses your camera to let you take and upload a profile photo.",
        "NSPhotoLibraryUsageDescription": "Ping uses your photo library to let you choose and upload a profile photo.",
        "NSPhotoLibraryAddUsageDescription": "Ping saves your selected profile photo.",
        "NFCReaderUsageDescription": "Ping needs NFC access to program your ring for contact sharing.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.nfc.readersession.formats": [
          "TAG"
        ]
      }
    },
    "android": {
      "package": "today.getping.app",
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.RECORD_AUDIO",
        "android.permission.NFC"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "f15c8ce6-81d5-41c9-ab51-a397fefa7c4c"
      }
    },
    "owner": "ping-organization",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f15c8ce6-81d5-41c9-ab51-a397fefa7c4c"
    }
  }
}
